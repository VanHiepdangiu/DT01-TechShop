@model List<Order>
@{ViewData["Title"]="Đơn hàng của tôi";}
<h1>Đơn hàng của tôi</h1><section class="panel table-wrap"><table class="table"><thead><tr><th>Mã đơn</th><th>Ngày đặt</th><th>Tổng tiền</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var o in Model){<tr><td>@o.Code</td><td>@o.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@o.Total.ToString("N0") ₫</td><td><span class="order-status">@OrderStates.Label(o.Status)</span></td><td><a href="/Orders/Details/@o.Id">Xem chi tiết →</a></td></tr>}</tbody></table>@if(!Model.Any()){<p class="empty">Bạn chưa có đơn hàng.</p>}</section>