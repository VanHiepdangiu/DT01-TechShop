@model Order
@{ViewData["Title"]=Model.Code;bool staff=User.IsInRole("Admin")||User.IsInRole("Staff");}
<div class="page-head"><div><span class="eyebrow">ORDER DETAILS</span><h1>Đơn hàng @Model.Code</h1><span class="order-status">@OrderStates.Label(Model.Status)</span></div><a class="btn btn-outline" href="/Orders/Invoice/@Model.Id">In hóa đơn</a></div><div class="checkout-grid"><section class="panel"><h2>Sản phẩm</h2><table class="table"><thead><tr><th>Tên hàng</th><th>SL</th><th>Giá đã chốt</th></tr></thead><tbody>@foreach(var l in Model.Items){<tr><td>@l.ProductName</td><td>@l.Quantity</td><td>@l.UnitPrice.ToString("N0") ₫</td></tr>}</tbody></table><div class="timeline"><h3>Lịch sử trạng thái</h3>@foreach(var h in Model.History.OrderBy(x=>x.CreatedAt)){<p><strong>@OrderStates.Label(h.Status)</strong> · @h.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")<br/><small>@h.Note</small></p>}</div>@if(Model.UserId==User.UserId()&&(Model.Status==OrderStates.New||Model.Status==OrderStates.PendingPayment)){<form action="/Orders/Cancel" method="post" data-confirm="Hủy đơn và hoàn lại tồn kho?">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.Id"/><button class="btn btn-outline">Hủy đơn</button></form>}@if(Model.UserId==User.UserId()&&Model.Status==OrderStates.Completed){<form action="/Orders/RequestReturn" method="post" class="mt-3">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.Id"/><textarea name="reason" class="form-control" required maxlength="500" placeholder="Lý do đổi trả"></textarea><button class="btn btn-outline mt-2">Gửi yêu cầu đổi trả</button></form>}@if(staff){<form action="/Orders/Change" method="post" class="mt-4">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@Model.Id"/><label>Trạng thái tiếp theo<select name="status" class="form-control">@foreach(var s in new[]{OrderStates.Packing,OrderStates.Shipping,OrderStates.Completed,OrderStates.Cancelled,OrderStates.Returned}){@if(OrderStates.CanMove(Model.Status,s)){<option value="@s">@OrderStates.Label(s)</option>}}</select></label><label>Ghi chú nội bộ<textarea name="note" maxlength="1000" class="form-control">@Model.InternalNote</textarea></label><button class="btn btn-primary mt-2">Cập nhật</button></form>}</section><aside class="panel summary"><h2>Thông tin giao hàng</h2><strong>@Model.FullName</strong><p>@Model.Phone<br/>@Model.ShippingAddress</p><hr/><p>Tiền hàng: @Model.Subtotal.ToString("N0") ₫</p><p>Giảm giá: −@Model.Discount.ToString("N0") ₫</p><p>Vận chuyển: @Model.ShippingFee.ToString("N0") ₫</p><div class="price">@Model.Total.ToString("N0") ₫</div><p>@Model.PaymentMethod · @(Model.PaymentStatus=="Paid"?"Đã thanh toán":"Chưa thanh toán")</p>@if(Model.Status==OrderStates.PendingPayment&&Model.UserId==User.UserId()){<a class="btn btn-primary" href="/Orders/Pay/@Model.Id">Thanh toán sandbox</a>}</aside></div>