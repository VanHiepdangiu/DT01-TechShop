@model List<ShopUser>
@{ViewData["Title"]="Phân quyền";var roles=(Dictionary<int,string>)ViewBag.Roles;}
<h1>Tài khoản & phân quyền</h1><section class="panel table-wrap"><table class="table"><thead><tr><th>Tên</th><th>Email</th><th>Vai trò</th><th>Thay đổi</th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Email</td><td>@roles[u.Id]</td><td>@if(u.Id!=User.UserId()){<form action="/Admin/Role" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@u.Id"/><select name="role" class="form-control"><option>Customer</option><option>Staff</option><option>Admin</option></select><button class="btn btn-outline">Lưu</button></form>}else{<small>Không đổi quyền của chính mình.</small>}</td></tr>}</tbody></table></section>