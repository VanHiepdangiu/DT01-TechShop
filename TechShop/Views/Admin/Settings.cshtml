@{ViewData["Title"]="Danh mục và ưu đãi";var cats=(List<Category>)ViewBag.Categories;var brands=(List<Brand>)ViewBag.Brands;var coupons=(List<Coupon>)ViewBag.Coupons;}
<h1>Danh mục · Thương hiệu · Mã giảm giá</h1><div class="checkout-grid"><section class="panel"><h2>Danh mục</h2>@foreach(var c in cats){<form action="/Admin/Category" method="post" class="d-flex gap-2 my-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id"/><input name="name" value="@c.Name" required maxlength="80" class="form-control"/><select name="active" class="form-control"><option value="true" selected="@c.IsActive">Bật</option><option value="false" selected="@(!c.IsActive)">Ẩn</option></select><button class="btn btn-outline">Lưu</button></form>}<form action="/Admin/Category" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input name="name" required maxlength="80" class="form-control" placeholder="Danh mục mới"/><button class="btn btn-primary">Thêm</button></form></section><section class="panel"><h2>Thương hiệu</h2>@foreach(var c in brands){<form action="/Admin/Brand" method="post" class="d-flex gap-2 my-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@c.Id"/><input name="name" value="@c.Name" required maxlength="80" class="form-control"/><select name="active" class="form-control"><option value="true" selected="@c.IsActive">Bật</option><option value="false" selected="@(!c.IsActive)">Ẩn</option></select><button class="btn btn-outline">Lưu</button></form>}<form action="/Admin/Brand" method="post" class="d-flex gap-2">@Html.AntiForgeryToken()<input name="name" required maxlength="80" class="form-control" placeholder="Thương hiệu mới"/><button class="btn btn-primary">Thêm</button></form></section></div><section class="panel mt-4"><h2>Mã giảm giá</h2><table class="table"><thead><tr><th>Mã</th><th>Giảm</th><th>Số lượt</th><th>Hết hạn</th></tr></thead><tbody>@foreach(var c in coupons){<tr><td>@c.Code</td><td>@c.DiscountPercent%</td><td>@c.UsedCount / @c.UsageLimit</td><td>@c.ExpiredAt.ToString("dd/MM/yyyy")</td></tr>}</tbody></table><form action="/Admin/Coupon" method="post" class="field-grid">@Html.AntiForgeryToken()<label>Mã<input name="code" class="form-control" required maxlength="30"/></label><label>% giảm<input name="percent" class="form-control" type="number" min="1" max="100" required/></label><label>Số lượt<input name="limit" class="form-control" type="number" min="1" required/></label><label>Ngày hết hạn<input name="expired" class="form-control" type="date" required/></label><button class="btn btn-primary align-self-end">Tạo mã</button></form></section>