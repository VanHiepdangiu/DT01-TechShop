@model List<Product>
@{ViewData["Title"]="Quản lý sản phẩm";}
<div class="page-head"><h1>Quản lý sản phẩm</h1><div class="d-flex gap-2"><a href="/Admin/ExportProducts" class="btn btn-outline">Xuất Excel</a><a href="/Admin/Edit" class="btn btn-primary">+ Thêm sản phẩm</a></div></div><div class="panel mb-3"><h2 class="h6">Nhập sản phẩm từ CSV</h2><form action="/Admin/Import" method="post" enctype="multipart/form-data" class="d-flex gap-2 align-items-center flex-wrap">@Html.AntiForgeryToken()<input type="file" name="file" accept=".csv" class="form-control" style="max-width:320px" required/><button class="btn btn-outline">Nhập CSV</button><span class="text-muted small">Cột: Tên, Giá, Giá KM (trống được), Tồn, Danh mục, Hãng (trống được), Mô tả. UTF-8, tối đa 500 dòng.</span></form></div><form method="get" class="d-flex gap-2 mb-3"><input name="q" class="form-control" placeholder="Tìm tên sản phẩm"/><button class="btn btn-outline">Tìm</button></form><div class="panel table-wrap"><table class="table"><thead><tr><th>Mã</th><th>Tên</th><th>Danh mục</th><th>Giá</th><th>Tồn</th><th>Hiển thị</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Id</td><td>@p.Name</td><td>@p.Category?.Name</td><td>@p.EffectivePrice.ToString("N0") ₫</td><td>@p.Stock</td><td>@(p.IsActive?"Đang bán":"Ẩn")</td><td><a href="/Admin/Edit/@p.Id">Sửa</a><form action="/Admin/Hide" method="post" class="d-inline" data-confirm="Ẩn sản phẩm này?">@Html.AntiForgeryToken()<input name="id" type="hidden" value="@p.Id"/><button class="btn btn-outline btn-sm">Ẩn</button></form></td></tr>}</tbody></table></div>