@model List<Product>
@{ViewData["Title"]="So sánh sản phẩm";}
<h1>So sánh tối đa 3 sản phẩm</h1><p>Đánh dấu “So sánh” tại danh sách sản phẩm, rồi mở nút So sánh đã chọn.</p>@if(Model.Count==0){<div class="empty"><a href="/Products">Chọn sản phẩm để so sánh →</a></div>}<div class="compare-grid">@foreach(var p in Model){<section class="panel"><img src="@(p.Images.FirstOrDefault()?.Url??"/images/laptop.svg")" alt="@p.Name" class="w-100" height="180"/><h2>@p.Name</h2><strong class="price">@p.EffectivePrice.ToString("N0") ₫</strong><table class="table">@foreach(var s in p.Specs){<tr><th>@s.SpecName</th><td>@s.SpecValue</td></tr>}</table><a class="btn btn-primary" href="/Products/Details/@p.Id">Chi tiết</a></section>}</div>