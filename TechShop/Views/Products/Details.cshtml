@model Product
@{ViewData["Title"]=Model.Name;}
<a href="/Products">← Quay lại sản phẩm</a><div class="checkout-grid mt-4"><section class="panel"><img id="main-photo" src="@(Model.Images.FirstOrDefault()?.Url??"/images/laptop.svg")" class="w-100" style="max-height:370px;object-fit:contain" alt="@Model.Name"/><div class="d-flex gap-2">@foreach(var im in Model.Images){<button class="btn btn-outline" type="button" onclick="document.getElementById('main-photo').src=this.dataset.src" data-src="@im.Url"><img src="@im.Url" width="60" alt="Ảnh sản phẩm"/></button>}</div></section><section class="panel"><span class="eyebrow">@Model.Brand?.Name</span><h1>@Model.Name</h1><div class="price fs-2">@Model.EffectivePrice.ToString("N0") ₫</div>@if(Model.SalePrice!=null){<div class="old-price">@Model.Price.ToString("N0") ₫</div>}<p class="stock">Còn @Model.Stock sản phẩm</p><p>@Model.Description</p><button class="btn btn-primary cart-add" data-product="@Model.Id" disabled="@(Model.Stock==0)">Thêm vào giỏ hàng</button><a class="btn btn-outline" href="/Products/Compare?ids=@Model.Id">So sánh</a><h3 class="mt-4">Thông số kỹ thuật</h3><table class="table spec-table">@foreach(var s in Model.Specs){<tr><th>@s.SpecName</th><td>@s.SpecValue</td></tr>}</table></section></div>
<section class="panel mt-4"><h2>Đánh giá (@Model.Reviews.Count)</h2>@foreach(var v in Model.Reviews.OrderByDescending(x=>x.CreatedAt)){<div class="border-bottom py-3"><strong>@v.User?.FullName · @v.Rating/5</strong><p>@v.Comment</p></div>}<form action="/Products/Review" method="post" class="mt-3">@Html.AntiForgeryToken()<input type="hidden" name="productId" value="@Model.Id"/><label>Số sao<select name="rating" class="form-control">@for(int i=5;i>=1;i--){<option>@i</option>}</select></label><textarea name="comment" required maxlength="1000" class="form-control my-2" placeholder="Chia sẻ trải nghiệm của bạn"></textarea><button class="btn btn-outline">Gửi đánh giá</button><small>Mỗi tài khoản một đánh giá / sản phẩm.</small></form></section>