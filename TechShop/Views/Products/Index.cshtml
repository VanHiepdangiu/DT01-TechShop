@model CatalogModel
@{ViewData["Title"]="Sản phẩm";}
<div class="page-head"><div><span class="eyebrow">FIND YOUR NEXT DEVICE</span><h1>Thiết bị công nghệ</h1><p>@Model.Total sản phẩm phù hợp</p></div><a href="/Products/Compare" id="compare-link" class="btn btn-outline">So sánh đã chọn</a></div>
<form class="catalog-toolbar panel" method="get"><input class="form-control" name="q" value="@Model.Q" placeholder="Tìm tên sản phẩm…"/><select class="form-control" name="categoryId"><option value="">Tất cả danh mục</option>@foreach(var x in Model.Categories){<option value="@x.Id" selected="@(x.Id==Model.CategoryId)">@x.Name</option>}</select><select class="form-control" name="brandId"><option value="">Tất cả thương hiệu</option>@foreach(var x in Model.Brands){<option value="@x.Id" selected="@(x.Id==Model.BrandId)">@x.Name</option>}</select><input class="form-control" name="min" type="number" min="0" value="@Model.Min" placeholder="Giá từ"/><input class="form-control" name="max" type="number" min="0" value="@Model.Max" placeholder="Giá đến"/><select class="form-control" name="sort"><option value="">Mới nhất</option><option value="priceAsc" selected="@(Model.Sort=="priceAsc")">Giá tăng</option><option value="priceDesc" selected="@(Model.Sort=="priceDesc")">Giá giảm</option><option value="name" selected="@(Model.Sort=="name")">Tên A–Z</option></select><button class="btn btn-primary">Lọc</button></form>
@if(Model.Products.Count==0){<div class="empty">Không tìm thấy sản phẩm. Hãy thử từ khóa khác.</div>}<div class="product-grid">@foreach(var p in Model.Products){<partial name="_ProductCard" model="p"/>}</div><div class="d-flex gap-2 mt-4">@for(int i=1;i<=Model.Pages;i++){<a class="btn @(i==Model.Page?"btn-primary":"btn-outline")" href="@Url.Action("Index",new{q=Model.Q,categoryId=Model.CategoryId,brandId=Model.BrandId,min=Model.Min,max=Model.Max,sort=Model.Sort,page=i})">@i</a>}</div>