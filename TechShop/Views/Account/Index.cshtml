@model AuthPage
@{ViewData["Title"]="Đăng nhập / Đăng ký";}
<section class="auth-shell"><div class="auth-art"><span class="eyebrow">WELCOME TO TECHSHOP</span><h1>Công nghệ tốt.<br/>Khởi đầu mới.</h1><p>Đăng nhập để lưu giỏ hàng, đặt mua và theo dõi đơn của bạn.</p><img src="/images/laptop.svg" alt="Thiết bị công nghệ" class="w-100"/></div><div class="auth-panel"><div class="auth-tabs"><button type="button" class="btn @(Model.RegisterTab?"btn-outline":"btn-primary")" data-auth="login">Đăng nhập</button><button type="button" class="btn @(Model.RegisterTab?"btn-primary":"btn-outline")" data-auth="register">Đăng ký</button></div><div asp-validation-summary="All" class="text-danger"></div>
<div class="auth-pane @(Model.RegisterTab?"":"active")" id="auth-login"><h2>Chào mừng trở lại</h2><form action="/Account/Login" method="post">@Html.AntiForgeryToken()<input asp-for="Login.ReturnUrl" type="hidden"/><label>Email<input asp-for="Login.Email" type="email" class="form-control" required autocomplete="username"/></label><label>Mật khẩu<input asp-for="Login.Password" class="form-control" required autocomplete="current-password"/></label><label><input asp-for="Login.RememberMe"/> Ghi nhớ đăng nhập</label><button class="btn btn-primary w-100 mt-3">Đăng nhập</button></form><a href="/Account/Forgot">Quên mật khẩu?</a></div>
<div class="auth-pane @(Model.RegisterTab?"active":"")" id="auth-register"><h2>Tạo tài khoản</h2><form action="/Account/Register" method="post">@Html.AntiForgeryToken()<label>Họ tên<input asp-for="Register.FullName" class="form-control" required maxlength="100"/></label><label>Email<input asp-for="Register.Email" type="email" class="form-control" required autocomplete="username"/></label><label>Mật khẩu<input asp-for="Register.Password" class="form-control" required minlength="8" autocomplete="new-password"/></label><small>Từ 8 ký tự, có hoa, thường, số và ký tự đặc biệt.</small><label>Nhập lại mật khẩu<input asp-for="Register.ConfirmPassword" class="form-control" required autocomplete="new-password"/></label><button class="btn btn-primary w-100 mt-3">Đăng ký tài khoản</button></form></div></div></section>