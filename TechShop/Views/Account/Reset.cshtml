@{ViewData["Title"]="Mật khẩu mới";}<div class="panel mx-auto" style="max-width:560px"><h1>Mật khẩu mới</h1><div asp-validation-summary="All" class="text-danger"></div><form method="post">@Html.AntiForgeryToken()<input name="email" type="hidden" value="@ViewBag.Email"/><input name="token" type="hidden" value="@ViewBag.Token"/><label>Mật khẩu<input name="password" type="password" class="form-control" required minlength="8"/></label><label>Xác nhận<input name="confirmPassword" type="password" class="form-control" required/></label><button class="btn btn-primary mt-3">Đổi mật khẩu</button></form></div>