@model ShopUser
@{ViewData["Title"]="Tài khoản";var addresses=(List<Address>)ViewBag.Addresses;}
<h1>Tài khoản của tôi</h1><div class="checkout-grid"><section class="panel"><h2>Thông tin cá nhân</h2><p>@Model.Email</p><form method="post">@Html.AntiForgeryToken()<label>Họ tên<input name="fullName" class="form-control" value="@Model.FullName" maxlength="100" required/></label><label>Điện thoại<input name="phone" class="form-control" value="@Model.PhoneNumber"/></label><button class="btn btn-primary mt-3">Lưu thông tin</button></form><a href="/Account/Forgot">Đổi / đặt lại mật khẩu</a></section><section class="panel"><h2>Sổ địa chỉ</h2>@foreach(var a in addresses){<div class="border-bottom py-3"><strong>@a.Recipient · @a.Phone</strong><p>@a.Detail</p><form action="/Account/DeleteAddress" method="post">@Html.AntiForgeryToken()<input name="id" value="@a.Id" type="hidden"/><button class="btn btn-outline btn-sm">Xóa địa chỉ</button></form></div>}<form action="/Account/AddAddress" method="post">@Html.AntiForgeryToken()<label>Người nhận<input name="Recipient" class="form-control" required maxlength="100"/></label><label>Điện thoại<input name="Phone" class="form-control" required pattern="0[0-9]{9}"/></label><label>Địa chỉ<input name="Detail" class="form-control" required maxlength="300"/></label><button class="btn btn-primary mt-3">Thêm địa chỉ</button></form></section></div>