@model CheckoutModel
@{ViewData["Title"]="Đặt hàng";var lines=(List<CartViewLine>)ViewBag.Lines;var subtotal=lines.Sum(x=>x.Amount);var addresses=(List<Address>)ViewBag.Addresses;}
<h1>Hoàn tất đơn hàng</h1><div class="checkout-grid"><section class="panel"><div asp-validation-summary="All" class="text-danger" role="alert"></div><form method="post" id="checkout-form">@Html.AntiForgeryToken()<input asp-for="Key" type="hidden"/>@if(addresses.Any()){<label>Chọn địa chỉ đã lưu<select class="form-control" id="address-picker"><option value="">Nhập địa chỉ mới</option>@foreach(var a in addresses){<option data-name="@a.Recipient" data-phone="@a.Phone" data-address="@a.Detail">@a.Detail</option>}</select></label>}<label>Họ tên người nhận<input asp-for="FullName" class="form-control" required maxlength="100"/></label><label>Số điện thoại<input asp-for="Phone" class="form-control" required pattern="0[0-9]{9}" placeholder="10 chữ số, bắt đầu bằng 0"/></label><label>Địa chỉ giao hàng<textarea asp-for="Address" class="form-control" required maxlength="300"></textarea></label><label>Mã giảm giá<input asp-for="CouponCode" class="form-control" placeholder="Ví dụ TECH10" maxlength="30"/></label><label>Thanh toán<select asp-for="PaymentMethod" class="form-control"><option value="COD">Thanh toán khi nhận hàng (COD)</option><option value="VNPay" disabled="@(!(bool)ViewBag.VnPay)">VNPay sandbox @(!(bool)ViewBag.VnPay?"— chưa cấu hình":"")</option><option value="BankTransfer" disabled="@(!(bool)ViewBag.Bank)">Chuyển khoản ngân hàng @((bool)ViewBag.Bank?("— "+ViewBag.BankName):"— chưa cấu hình")</option></select></label><button class="btn btn-primary w-100 mt-4" id="place-order">Xác nhận đặt hàng</button></form></section><aside class="panel summary"><h2>Đơn hàng dự kiến</h2>@foreach(var l in lines){<p>@l.Product.Name × @l.Quantity <strong class="d-block">@l.Amount.ToString("N0") ₫</strong></p>}<hr/><p>Tiền hàng: @subtotal.ToString("N0") ₫</p><p>Vận chuyển: @(subtotal>=10000000?"Miễn phí":"30.000 ₫")</p><small>Giảm giá và tổng cuối cùng do server xác định. Đơn thất bại sẽ không trừ kho. Mỗi lần đặt có mã chống tạo trùng.</small></aside></div>