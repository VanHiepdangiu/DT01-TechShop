@model List<CartViewLine>
@{ViewData["Title"]="Giỏ hàng";var subtotal=Model.Sum(x=>x.Amount);}
<div class="page-head"><h1>Giỏ hàng của bạn</h1><a href="/Products">Tiếp tục mua sắm →</a></div>@if(!Model.Any()){<div class="empty">Giỏ hàng đang trống. <a href="/Products">Khám phá sản phẩm</a></div>}else{<div class="checkout-grid"><section class="panel table-wrap"><table class="table align-middle"><thead><tr><th>Sản phẩm</th><th>Giá</th><th>Số lượng</th><th>Thành tiền</th><th></th></tr></thead><tbody>@foreach(var l in Model){<tr><td><a href="/Products/Details/@l.Product.Id">@l.Product.Name</a><small class="d-block">Tồn kho hiện tại: @l.Product.Stock</small></td><td>@l.Product.EffectivePrice.ToString("N0") ₫</td><td><input class="form-control cart-qty" type="number" min="1" max="99" value="@l.Quantity" data-product="@l.Product.Id" style="width:85px"/></td><td>@l.Amount.ToString("N0") ₫</td><td><button class="btn btn-outline cart-remove" data-product="@l.Product.Id">Xóa</button></td></tr>}</tbody></table></section><aside class="panel summary"><h2>Tạm tính</h2><div class="price">@subtotal.ToString("N0") ₫</div><p>Phí giao hàng 30.000 ₫; miễn phí với giá hàng từ 10 triệu. Mã giảm giá được kiểm tra khi đặt hàng.</p><a class="btn btn-primary w-100" href="/Checkout">Tiến hành đặt hàng</a><small>Tồn kho và giá được kiểm tra lại tại server. Thêm vào giỏ chưa giữ hàng.</small></aside></div>}