@model Product
<article class="product-card"><a class="product-image" href="/Products/Details/@Model.Id"><img loading="lazy" src="@(Model.Images.FirstOrDefault()?.Url??"/images/laptop.svg")" alt="Minh họa @Model.Name"/></a><div class="product-body"><span class="eyebrow">@Model.Category?.Name</span><h3><a href="/Products/Details/@Model.Id">@Model.Name</a></h3><div class="price">@Model.EffectivePrice.ToString("N0") ₫</div>@if(Model.SalePrice.HasValue){<div class="old-price">@Model.Price.ToString("N0") ₫</div>}<p class="stock">@(Model.Stock>0?$"Còn {Model.Stock} sản phẩm":"Tạm hết hàng")</p><div class="d-flex gap-2 flex-wrap"><button class="btn btn-primary cart-add" data-product="@Model.Id" disabled="@(Model.Stock==0)">Thêm vào giỏ</button><label class="small"><input type="checkbox" class="compare-pick" value="@Model.Id"/> So sánh</label></div></div></article>