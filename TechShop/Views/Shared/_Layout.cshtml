@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Anti
@{var csrf=Anti.GetAndStoreTokens(Context).RequestToken;}
<!DOCTYPE html><html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="csrf-token" content="@csrf"/><title>@ViewData["Title"] — TechShop</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/><link rel="stylesheet" href="~/css/shop.css" asp-append-version="true"/></head><body>
<header class="site-header"><div class="shell d-flex align-items-center justify-content-between gap-3"><a class="brand" href="/">Tech<span>Shop</span><small>SMART TECH. BETTER LIFE.</small></a><nav class="nav-links"><a href="/Products">Sản phẩm</a><a href="/Products/Compare">So sánh</a>@if(User.Identity?.IsAuthenticated==true){<a href="/Orders">Đơn hàng</a><a href="/Cart">Giỏ hàng <span class="badge" id="cart-count">@CartSession.Read(Context.Session).Sum(x=>x.Quantity)</span></a>}</nav><div class="user-menu">@if(User.Identity?.IsAuthenticated==true){@if(User.IsInRole("Admin")||User.IsInRole("Staff")){<a href="/Admin">Quản trị</a>}<a href="/Account/Profile">Tài khoản</a><form action="/Account/Logout" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline btn-sm">Thoát</button></form>}else{<a href="/Account">Đăng nhập</a>}</div></div></header>
<main class="shell py-4">@if(TempData["Message"]!=null){<div class="notice" role="status">@TempData["Message"]</div>}@if(TempData["Error"]!=null){<div class="notice error" role="alert">@TempData["Error"]</div>}@RenderBody()</main>
<footer class="footer"><div class="shell d-flex justify-content-between flex-wrap gap-3"><div><strong>TechShop</strong><p>Thiết bị phù hợp. Trải nghiệm tốt hơn.</p></div><div>Website học tập — ảnh minh họa, không giao dịch thật.<br/>VNPay sandbox và SMTP cần cấu hình riêng.</div></div></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/shop.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>